# Aplicación
APP_NAME=Estetika-Elora
APP_ENV=development
APP_DEBUG=True
APP_PORT=8000
# Base de datos
DATABASE_URL="sqlite:///./dev.db"
# Seguridad
SECRET_KEY=cambia-esta-clave-por-una-segura
ACCESS_TOKEN_EXPIRE_MINUTES=60
# URL pública de la API (se usa para armar las URL de imágenes guardadas en local)
PUBLIC_BASE_URL=http://localhost:8000
# Mapas: Nominatim (OpenStreetMap) exige un User-Agent que identifique la aplicación
NOMINATIM_USER_AGENT="EstetikaElora/0.1 (proyecto academico)"
# Almacenamiento de imágenes: Cloudinary (si están vacías se guarda en la carpeta uploads/)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=estetika-elora
# Correo (API-E03): Brevo. Si BREVO_API_KEY o CORREO_REMITENTE están vacías, el correo se
# imprime en la terminal del servidor en vez de enviarse.
BREVO_API_KEY=
CORREO_REMITENTE=
CORREO_REMITENTE_NOMBRE=Estetika Elora
# Vigencia en horas del enlace de activación de cuenta (HU-01)
TOKEN_VERIFICACION_HORAS=24
