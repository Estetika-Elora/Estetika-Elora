# Aplicación
APP_NAME=Estetika-Elora
APP_ENV=development
APP_DEBUG=True
APP_PORT=8000
# Base de datos
DATABASE_URL="sqlite:///./dev.db"
# Seguridad
SECRET_KEY=cambia-esta-clave-por-una-segura
ACCESS_TOKEN_EXPIRE_MINUTES=30
# URL pública de la API (se usa para armar las URL de imágenes guardadas en local)
PUBLIC_BASE_URL=http://localhost:8000
# Mapas: Nominatim (OpenStreetMap) exige un User-Agent que identifique la aplicación
NOMINATIM_USER_AGENT="EstetikaElora/0.1 (proyecto academico)"
# Almacenamiento de imágenes: Cloudinary (si están vacías se guarda en la carpeta uploads/)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=estetika-elora
